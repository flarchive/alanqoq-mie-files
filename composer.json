{
  "name": "mie/flarum-files",
  "description": "Private file library for Flarum",
  "type": "flarum-extension",
  "license": "MIT",
  "require": {
    "aws/aws-sdk-php": "^3.0",
    "flarum/core": "^2.0@beta"
  },
  "require-dev": {"phpunit/phpunit": "^10.0", "phpstan/phpstan": "^1.11"},
  "autoload": {"psr-4": {"Mie\\FlarumFiles\\": "src/"}},
  "autoload-dev": {"psr-4": {"Mie\\FlarumFiles\\Tests\\": "tests/php/"}},
  "extra": {"flarum-extension": {"title": "Private files", "icon": {"name": "fas fa-file", "backgroundColor": "#3867d6", "color": "#fff"}}},
  "scripts": {
    "lint": "find src migrations tests/php -name '*.php' -print0 | xargs -0 -n1 php -l && php -l extend.php",
    "analyse": "phpstan analyse --no-progress",
    "test": "phpunit",
    "test:integration": "phpunit --testsuite integration"
  },
  "minimum-stability": "beta",
  "prefer-stable": true,
  "config": {"sort-packages": true}
}
